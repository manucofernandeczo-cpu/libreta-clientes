{
  "name": "libreta-clientes",
  "version": "1.1.0",
  "description": "Libreta de clientes con una hoja por cliente",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.libreta.clientes",
    "productName": "Libreta de Clientes",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}